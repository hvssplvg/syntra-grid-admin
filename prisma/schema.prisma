/**
 * =============================================================================
 * CALENDAR: EVENTS
 * =============================================================================
 * Stores events created directly inside Syntra Grid.
 * System owned records such as approved or recorded LeaveRequest records,
 * recruitment interviews and deployments remain in their own source tables.
 * The Calendar API aggregates those sources into one calendar feed.
 * =============================================================================
 */

model CalendarEvent {
  id String @id @default(cuid())

  title       String
  description String?

  type     CalendarEventType
  scope    CalendarEventScope    @default(PERSONAL)
  priority CalendarEventPriority @default(NORMAL)
  status   CalendarEventStatus   @default(SCHEDULED)

  startAt DateTime
  endAt   DateTime?

  allDay Boolean @default(false)

  // IANA timezone, e.g. Europe/London or Africa/Lagos.
  timezone String?

  // Private event details can be masked by the API for unauthorised viewers.
  private Boolean @default(false)

  location   String?
  meetingUrl String?

  // Employee whose calendar owns this event.
  ownerId String

  // Admin actor who created the event.
  createdById String

  // Last admin actor who modified the event.
  updatedById String?

  // Optional organisational context.
  departmentId String?

  // Optional real client or project context.
  clientId  String?
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      Employee    @relation("CalendarEventOwner", fields: [ownerId], references: [id])
  createdBy  AdminUser   @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  updatedBy  AdminUser?  @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])

  attendees CalendarEventAttendee[]

  @@index([ownerId])
  @@index([createdById])
  @@index([updatedById])
  @@index([departmentId])
  @@index([clientId])
  @@index([projectId])
  @@index([type])
  @@index([scope])
  @@index([priority])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([startAt, endAt])
  @@index([ownerId, startAt])
  @@index([departmentId, startAt])
  @@index([clientId, startAt])
  @@index([projectId, startAt])
  @@index([scope, startAt])
  @@index([status, startAt])
}

/**
 * =============================================================================
 * CALENDAR: ATTENDEES
 * =============================================================================
 */

model CalendarEventAttendee {
  id String @id @default(cuid())

  eventId    String
  employeeId String

  status CalendarAttendanceStatus @default(PENDING)

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([eventId, employeeId])
  @@index([eventId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
}

/**
 * =============================================================================
 * WORKLOAD: EMPLOYEE WORK SCHEDULES
 * =============================================================================
 * An employee's normal working capacity.
 * Allocations are planned work. This model is how much time the employee
 * has available before allocations and approved leave are considered.
 * Schedules are versioned rather than one per employee, so a change such as
 * "part time from 1 January" keeps the history intact for past reports.
 * The API picks the schedule whose effective window contains the date being
 * calculated. A schedule with no effectiveUntil is open ended.
 * Leave is not duplicated here. The Workload API subtracts APPROVED and
 * RECORDED LeaveRequest days from capacity.
 * =============================================================================
 */

model EmployeeWorkSchedule {
  id String @id @default(cuid())

  employeeId String

  /**
   * Cached weekly total of the daily hours below.
   * The server recalculates it whenever the daily hours change.
   * Examples: full time 40, part time 20.
   */
  weeklyHours Decimal @default(40) @db.Decimal(6, 2)

  /**
   * Daily working hours. These make capacity accurate for part time
   * staff and people who do not work a standard Monday to Friday week.
   */
  mondayHours    Decimal @default(8) @db.Decimal(5, 2)
  tuesdayHours   Decimal @default(8) @db.Decimal(5, 2)
  wednesdayHours Decimal @default(8) @db.Decimal(5, 2)
  thursdayHours  Decimal @default(8) @db.Decimal(5, 2)
  fridayHours    Decimal @default(8) @db.Decimal(5, 2)
  saturdayHours  Decimal @default(0) @db.Decimal(5, 2)
  sundayHours    Decimal @default(0) @db.Decimal(5, 2)

  /**
   * Share of capacity the business expects to be billable, e.g. 75 = 75%.
   * Lets Workload compare planned and actual billable utilisation.
   * Null means no target is set.
   */
  billableTargetPercent Decimal? @db.Decimal(5, 2)

  // IANA timezone used for working days and timesheet periods.
  timezone String?

  active Boolean @default(true)

  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  notes String?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy AdminUser? @relation("EmployeeWorkScheduleCreatedBy", fields: [createdById], references: [id])

  @@index([employeeId])
  @@index([active])
  @@index([effectiveFrom])
  @@index([effectiveUntil])
  @@index([createdById])
  @@index([employeeId, active])
  @@index([employeeId, effectiveFrom])
}

/**
 * =============================================================================
 * WORKLOAD: ALLOCATIONS
 * =============================================================================
 * Planned use of an employee's capacity.
 * Examples:
 * Hassan on RentWise, 1 to 30 September, 20 hours a week
 * Developer A on Esteem Learning Centre, 15 September to 31 October, 50%
 * Internal work can exist without a client or project.
 * =============================================================================
 */

model WorkloadAllocation {
  id String @id @default(cuid())

  employeeId String

  /**
   * Optional context. Client and project work should normally set
   * projectId (clientId is kept for fast filtering and for client work
   * that is not tied to one project). Internal work may use departmentId
   * or no context at all.
   */
  departmentId String?
  clientId     String?
  projectId    String?

  title       String
  description String?

  type     WorkloadAllocationType   @default(PROJECT)
  status   WorkloadAllocationStatus @default(PLANNED)
  priority WorkloadPriority         @default(NORMAL)

  startDate DateTime
  endDate   DateTime

  /**
   * Allocation is either planned hours or a share of capacity.
   * The API validates that the field matching allocationMode is set.
   * HOURS:      hoursPerWeek, planned hours per week.
   * PERCENTAGE: allocationPercent, e.g. 50 = 50% of weekly capacity.
   */
  allocationMode WorkloadAllocationMode @default(HOURS)

  hoursPerWeek      Decimal? @db.Decimal(6, 2)
  allocationPercent Decimal? @db.Decimal(5, 2)

  /**
   * Optional total budget for the whole allocation, e.g. a 60 hour
   * fixed scope piece of work. Timesheet entries linked to this
   * allocation show how much of the budget has been used.
   */
  budgetHours Decimal? @db.Decimal(8, 2)

  billable Boolean @default(true)

  notes String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])

  createdBy AdminUser? @relation("WorkloadAllocationCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser? @relation("WorkloadAllocationUpdatedBy", fields: [updatedById], references: [id])

  // Actual time logged against this plan.
  timesheetEntries TimesheetEntry[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdById])
  @@index([updatedById])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
  @@index([startDate, endDate])
  @@index([employeeId, status])
  @@index([employeeId, startDate, endDate])
  @@index([projectId, startDate, endDate])
  @@index([clientId, startDate, endDate])
}

/**
 * =============================================================================
 * TIMESHEETS
 * =============================================================================
 * One timesheet is one employee's reporting period, for example:
 * Hassan, week of 21 September 2026, Submitted
 * The app starts with weekly periods, and the schema supports other
 * periods later. The individual work records live in TimesheetEntry.
 * =============================================================================
 */

model Timesheet {
  id String @id @default(cuid())

  employeeId String

  timesheetRef String? @unique

  status TimesheetStatus @default(DRAFT)

  periodStart DateTime
  periodEnd   DateTime

  /**
   * Cached totals keep dashboard and reporting queries cheap.
   * The server recalculates them whenever entries change.
   * expectedHours is the employee's capacity for the period, taken from
   * their work schedule minus approved leave, so the review screen can
   * show "32 of 40 hours logged" without recalculating.
   */
  totalHours    Decimal  @default(0) @db.Decimal(8, 2)
  billableHours Decimal  @default(0) @db.Decimal(8, 2)
  expectedHours Decimal? @db.Decimal(8, 2)

  employeeNote String?

  // Manager or admin review.
  reviewedById String?
  reviewedAt   DateTime?

  reviewNote      String?
  rejectionReason String?

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  /**
   * Locked timesheets cannot be edited, for example once billable hours
   * have been invoiced or payroll has run. Unlocking is an audited action.
   */
  lockedAt   DateTime?
  lockedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewedBy AdminUser? @relation("TimesheetReviewedBy", fields: [reviewedById], references: [id])
  lockedBy   AdminUser? @relation("TimesheetLockedBy", fields: [lockedById], references: [id])

  entries    TimesheetEntry[]
  activities TimesheetActivity[]

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([submittedAt])
  @@index([reviewedById])
  @@index([lockedById])
  @@index([employeeId, status])
  @@index([employeeId, periodStart])
  @@index([status, periodStart])
}

/**
 * =============================================================================
 * TIMESHEETS: ENTRIES
 * =============================================================================
 * Actual work performed.
 * Entries may be linked to a real client or project, to the workload
 * allocation they were planned under, or be internal, admin, training or
 * support work.
 * employeeId is duplicated from the parent timesheet on purpose, so
 * per person reports do not need a join. The API keeps it in sync.
 * =============================================================================
 */

model TimesheetEntry {
  id String @id @default(cuid())

  timesheetId String
  employeeId  String

  clientId     String?
  projectId    String?
  allocationId String?

  // Calendar date on which the work happened.
  workDate DateTime

  type TimesheetEntryType @default(PROJECT)

  title       String
  description String?

  /**
   * Duration in decimal hours.
   * 1.50 = 1 hour 30 minutes
   * 0.25 = 15 minutes
   */
  hours Decimal @db.Decimal(6, 2)

  billable Boolean @default(false)

  /**
   * Optional clock times. Not required, because people often just
   * record "3 hours on RentWise".
   */
  startedAt DateTime?
  endedAt   DateTime?

  /**
   * Billing. When billable hours are invoiced, the entry is linked to the
   * invoice so the same hours are never billed twice.
   */
  invoiceId String?
  billedAt  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet  Timesheet           @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client     Client?             @relation(fields: [clientId], references: [id])
  project    Project?            @relation(fields: [projectId], references: [id])
  allocation WorkloadAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  invoice    ClientInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([employeeId])
  @@index([clientId])
  @@index([projectId])
  @@index([allocationId])
  @@index([invoiceId])
  @@index([workDate])
  @@index([type])
  @@index([billable])
  @@index([employeeId, workDate])
  @@index([projectId, workDate])
  @@index([clientId, workDate])
  @@index([timesheetId, workDate])
  @@index([allocationId, workDate])
  @@index([clientId, billable, invoiceId])
}

/**
 * =============================================================================
 * TIMESHEETS: ACTIVITY
 * =============================================================================
 * Audit trail for a timesheet: submitted, approved, rejected, reopened,
 * locked and so on. Mirrors LeaveActivity.
 * =============================================================================
 */

model TimesheetActivity {
  id String @id @default(cuid())

  timesheetId String
  employeeId  String
  actorId     String?

  type TimesheetActivityType

  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  timesheet Timesheet  @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actor     AdminUser? @relation("TimesheetActivityActor", fields: [actorId], references: [id])

  @@index([timesheetId])
  @@index([employeeId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

